<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.demo.StoryController"
            prefWidth="800" prefHeight="600"
            stylesheets="@story.css">

    <!-- Mute Button -->


    <VBox alignment="CENTER"
          spacing="20"
          prefWidth="800" prefHeight="600">

        <Label fx:id="storyText" wrapText="true" maxWidth="700" styleClass="story-text" />

        <Button fx:id="nextButton" text="Next" onAction="#handleNext" styleClass="story-button" />

        <Button fx:id="muteButton" text="✖" onAction="#handleMute" styleClass="story-button" />

    </VBox>
</AnchorPane>
