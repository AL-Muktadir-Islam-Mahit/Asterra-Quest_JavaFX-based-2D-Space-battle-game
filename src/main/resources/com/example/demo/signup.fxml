<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.example.demo.SignupController"
           stylesheets="@style.css"
           style="-fx-background-color: linear-gradient(to bottom right, #0f2027, #203a43, #2c5364);">

    <VBox alignment="CENTER" spacing="20" maxWidth="400"
          style="-fx-background-color: rgba(0,0,0,0.4);
                 -fx-background-radius: 20;
                 -fx-effect: dropshadow(gaussian, #00ccff, 20, 0.3, 0, 0);">

        <padding>
            <Insets top="40" right="40" bottom="40" left="40"/>
        </padding>

        <Label text="Create Account"
               style="-fx-font-size: 34px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #00e5ff;
                      -fx-effect: dropshadow(gaussian, #0088ff, 8, 0.3, 0, 0);"/>

        <TextField fx:id="usernameField" promptText="Username" maxWidth="300"
                   style="-fx-background-radius: 10;
                          -fx-background-color: rgba(255,255,255,0.1);
                          -fx-text-fill: white;
                          -fx-prompt-text-fill: #88ccff;
                          -fx-font-size: 16px;
                          -fx-padding: 10 14;"/>

        <PasswordField fx:id="passwordField" promptText="Password" maxWidth="300"
                       style="-fx-background-radius: 10;
                              -fx-background-color: rgba(255,255,255,0.1);
                              -fx-text-fill: white;
                              -fx-prompt-text-fill: #88ccff;
                              -fx-font-size: 16px;
                              -fx-padding: 10 14;"/>

        <PasswordField fx:id="confirmPasswordField" promptText="Confirm Password" maxWidth="300"
                       style="-fx-background-radius: 10;
                              -fx-background-color: rgba(255,255,255,0.1);
                              -fx-text-fill: white;
                              -fx-prompt-text-fill: #88ccff;
                              -fx-font-size: 16px;
                              -fx-padding: 10 14;"/>

        <Button text="Register" onAction="#handleSignup" maxWidth="300"
                style="-fx-font-size: 18px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 10;
                       -fx-background-color: linear-gradient(to right, #00bfff, #00ffff);
                       -fx-text-fill: #001f33;
                       -fx-padding: 10 0;
                       -fx-cursor: hand;
                       -fx-effect: dropshadow(gaussian, #00aaff, 8, 0.3, 0, 0);"/>

        <Separator maxWidth="280" style="-fx-background-color: #00ccff;"/>

        <HBox alignment="CENTER" spacing="5">
            <Label text="Already have an account?"
                   style="-fx-text-fill: #aaddff; -fx-font-size: 14px;"/>
            <Hyperlink text="Login" onAction="#goToLogin"
                       style="-fx-text-fill: #00ffff;
                              -fx-font-size: 16px;
                              -fx-font-weight: bold;
                              -fx-border-color: transparent;"/>
        </HBox>

        <Button text="← Back"  maxWidth="100"
                style="-fx-font-size: 14px;
                       -fx-text-fill: #00e5ff;
                       -fx-background-color: transparent;
                       -fx-border-color: #00e5ff;
                       -fx-border-radius: 8;
                       -fx-padding: 5 10;
                       -fx-cursor: hand;"/>

    </VBox>

</StackPane>
