<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.demo.LoadingController"
      alignment="CENTER"
      spacing="20"
      stylesheets="@loading.css"
      prefWidth="600" prefHeight="400">

    <Label text="Loading..." styleClass="loading-title"/>
    <ProgressBar fx:id="progressBar" prefWidth="400" progress="0.0"/>
    <Label fx:id="progressText" text="0%" styleClass="loading-percent"/>

</VBox>
