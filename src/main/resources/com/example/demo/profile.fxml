<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.demo.ProfileController"
            stylesheets="@profile.css">

    <!-- Top Bar -->
    <top>
        <HBox spacing="10" styleClass="top-bar" alignment="CENTER_LEFT">
            <padding>
                <Insets top="12" right="20" bottom="12" left="20"/>
            </padding>
            <Button text="← Back" styleClass="top-button" onAction="#onBackClick"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Logout" styleClass="top-button" onAction="#onLogoutClick"/>
        </HBox>
    </top>

    <!-- Profile Info -->
    <center>
        <VBox alignment="CENTER_LEFT" spacing="15" styleClass="profile-panel">
            <padding>
                <Insets left="50" right="50" top="40" bottom="40"/>
            </padding>

            <HBox spacing="10">
                <Label text="Username:" styleClass="profile-label"/>
                <Label fx:id="usernameLabel" styleClass="profile-value"/>
            </HBox>

            <HBox spacing="10">
                <Label text="Password:" styleClass="profile-label"/>
                <Label fx:id="passwordLabel" styleClass="profile-value"/>
            </HBox>

            <HBox spacing="10">
                <Label text="Player Level:" styleClass="profile-label"/>
                <Label fx:id="levelLabel" styleClass="profile-value"/>
            </HBox>

            <HBox spacing="10">
                <Label text="Wins:" styleClass="profile-label"/>
                <Label fx:id="winsLabel" styleClass="profile-value"/>
            </HBox>

            <HBox spacing="10">
                <Label text="Losses:" styleClass="profile-label"/>
                <Label fx:id="lossesLabel" styleClass="profile-value"/>
            </HBox>

            <HBox spacing="10">
                <Label text="W/L Ratio:" styleClass="profile-label"/>
                <Label fx:id="ratioLabel" styleClass="profile-value"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>
