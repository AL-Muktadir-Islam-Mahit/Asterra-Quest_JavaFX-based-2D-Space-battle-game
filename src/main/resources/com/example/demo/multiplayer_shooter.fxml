<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.demo.MultiplayerShooterController"
            fx:id="rootPane"
            focusTraversable="true"
            prefWidth="800" prefHeight="500"
            stylesheets="@multiplayer_shooter.css">

    <Canvas fx:id="gameCanvas" width="800" height="500" />

    <TextField fx:id="inviteField" layoutX="10" layoutY="5" promptText="username to invite" prefWidth="200"/>

    <Button fx:id="inviteButton"
            text="Invite"
            layoutX="215"
            layoutY="5"
            styleClass="neon-button"/>

    <Button fx:id="backButton"
            text="← Back"
            layoutX="600"
            layoutY="5"
            onAction="#onBackClick"
            styleClass="neon-button"/>
</AnchorPane>
